# Generate a long random token before deployment.
MOCHIMONO_TOKEN=replace-with-a-long-random-token
MOCHIMONO_DATA=/var/lib/mochimono
HOST=127.0.0.1
PORT=8642

# Keep low-performance VPS installs I/O-light. Integrity verification can still
# be run manually; raise this later if scheduled server-side scrubbing is wanted.
MOCHIMONO_SCRUB_DAYS=0
